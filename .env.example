# Copy this file to .env and fill in your own values.
# .env is gitignored — it will never be committed or pushed to GitHub.

# ── Frontier Developments cAPI login ────────────────────────────────────────
# 1. Register an application at https://user.frontierstore.net/dev
# 2. Set its redirect URI to exactly match FRONTIER_REDIRECT_URI below
#    (protocol, host, port, and path must match character-for-character).
# 3. Paste the Client ID it gives you here. PKCE means no client secret
#    is needed — Frontier's docs are explicit that PKCE apps skip it.
FRONTIER_CLIENT_ID=
FRONTIER_REDIRECT_URI=http://localhost:3000/auth/callback

# ── Session signing secret ──────────────────────────────────────────────────
# Any long random string. Used only to sign the session cookie — generate
# one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── Server port (optional, defaults to 3000) ────────────────────────────────
PORT=3000
